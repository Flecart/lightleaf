# --- Lightleaf configuration (see README for all options) ---------------------------------
# Public domain, used by the optional Caddy HTTPS proxy (docker compose --profile https up -d)
LIGHTLEAF_DOMAIN=latex.example.com
# Host port. With the Caddy proxy, use 127.0.0.1:8080 so the app is only reachable through it.
LIGHTLEAF_PORT=8080

# Who can register in the browser:
#   closed = nobody (admins create accounts: `docker compose exec lightleaf lightleaf user add ...`)
#   local  = only requests made on the server machine itself (never true inside Docker)
#   open   = anyone who can reach the server
LIGHTLEAF_SIGNUP=closed
# Create this admin on first start (optional; or use `lightleaf user add --admin <email>`)
LIGHTLEAF_ADMIN_EMAIL=
LIGHTLEAF_ADMIN_PASSWORD=

LIGHTLEAF_MAX_COMPILES=2
LIGHTLEAF_COMPILE_TIMEOUT=90
# Per-user fairness: concurrent compiles and compiles per minute
LIGHTLEAF_COMPILES_PER_USER=2
LIGHTLEAF_COMPILES_PER_MINUTE=30
LIGHTLEAF_MAX_UPLOAD_MB=50
# Quotas (0 = unlimited)
LIGHTLEAF_MAX_PROJECTS=0
LIGHTLEAF_MAX_PROJECT_MB=0
# Set to true when served over HTTPS (always true with the Caddy profile)
LIGHTLEAF_SECURE_COOKIES=false
# Set to true behind a reverse proxy (e.g. the Caddy profile) so rate limits see real client IPs.
# Never enable it when clients can reach Lightleaf directly: they could fake their IP.
LIGHTLEAF_TRUST_PROXY=false
# Session lifetime and inactivity timeout, in days
LIGHTLEAF_SESSION_DAYS=30
LIGHTLEAF_SESSION_IDLE_DAYS=14
# "Source code" link in the UI (AGPL-3.0). Point it at your fork if you modify Lightleaf.
LIGHTLEAF_SOURCE_URL=
LIGHTLEAF_SITE_NAME=Lightleaf

# Container memory limit
LIGHTLEAF_MEMORY=1g

# Prometheus metrics at /metrics: always reachable from the server itself; set a token to
# scrape it from elsewhere (Authorization: Bearer <token>).
LIGHTLEAF_METRICS_TOKEN=
